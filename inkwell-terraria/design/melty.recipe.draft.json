{
  "schemaVersion": 1,
  "mode": "installed",
  "games": [
    { "slug": "terraria", "role": "primary", "version": ">=1.4.5" },
    { "slug": "custom-cuphead", "role": "secondary", "ownCopy": true }
  ],
  "components": [
    {
      "id": "main",
      "fileName": "inkwell-terraria-0.1.1.zip",
      "label": "Inkwell Terraria",
      "kind": "main",
      "required": true
    }
  ],
  "requirements": [],
  "mappings": [
    { "component": "main", "from": "prepare/", "to": "{managed}/prepare" },
    { "component": "main", "from": "README.md", "to": "{managed}" },
    { "component": "main", "from": "", "to": "{game}" }
  ],
  "launch": {
    "kind": "exe",
    "path": "{game}/InkwellWorld.exe",
    "cwd": "{game}"
  },
  "ownCopies": [
    {
      "game": "custom-cuphead",
      "names": ["cuphead"],
      "to": "{managed}/own/cuphead",
      "disc": {
        "files": [
          "Cuphead_Data/sharedassets8.assets",
          "Cuphead_Data/sharedassets8.resource",
          "Cuphead_Data/StreamingAssets/AssetBundles/atlas_player",
          "UnityPlayer.dll"
        ]
      },
      "prepare": {
        "launch": {
          "kind": "exe",
          "path": "{managed}/prepare/CupPrepare.exe",
          "args": ["--cuphead", "{managed}/own/cuphead", "--out", "{managed}/own/cuphead/cache"]
        },
        "done": { "file": "{managed}/own/cuphead/cache/ready.json" }
      }
    }
  ],
  "settings": [
    {
      "file": "{localappdata}/InkwellWorld/settings.cfg",
      "set": { "CacheDir": "{managed}/own/cuphead/cache" }
    }
  ],
  "runtimeData": ["{localappdata}/InkwellWorld"]
}
